# ─── База данных (обязательно) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── Discord OAuth2 (необязательно) ──────────────────────────────────
# Создайте приложение на https://discord.com/developers/applications
# и добавьте redirect: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Нужен только для продакшена, например:
# DISCORD_REDIRECT_URI=https://your-app.vercel.app/api/auth/discord/callback
